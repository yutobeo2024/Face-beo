generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Department {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  managerId Int?
  manager   Employee?  @relation("DeptManager", fields: [managerId], references: [id])
  employees Employee[] @relation("DeptMembers")
  // Cách duyệt đơn của Nhân viên trong phòng có quản lý (v1.7.0): MANAGER_OR_HR | TWO_STEP | MANAGER_ONLY
  approvalMode String @default("MANAGER_OR_HR")
  // v1.12.0: cả phòng không chấm công giờ giấc (vd. Ban Giám đốc) — không cảnh báo / Zalo, ẩn khỏi chấm công, báo cáo, xếp ca
  attendanceExempt Boolean @default(false)
}

// Danh mục chức danh / chuyên khoa (v1.7.0): thuộc tính của nhân viên, không ảnh hưởng phân quyền.
model JobTitle {
  id              Int        @id @default(autoincrement())
  name            String     @unique
  sortOrder       Int        @default(0)
  requiresLicense Boolean    @default(false) // v1.9.0: chức danh bắt buộc có Giấy phép hành nghề (cảnh báo khi thiếu)
  employees       Employee[]
}

model Specialty {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  sortOrder Int        @default(0)
  employees Employee[]
}

model Employee {
  id                 Int               @id @default(autoincrement())
  code               String            @unique
  name               String
  phone              String?           @unique // v1.8.0: không bắt buộc (đăng nhập bằng mã NV vẫn được); SQLite cho nhiều NULL
  // Thông tin cá nhân (v1.8.0) — chỉ Nhân sự/Quản trị và chính chủ xem; không vào tin Zalo, không ghi giá trị vào nhật ký.
  nationalId         String?           @unique // CCCD 12 số hoặc CMND 9 số
  dateOfBirth        String? // "YYYY-MM-DD"
  gender             String? // NAM | NU | KHAC
  address            String?
  // v1.10.0: ảnh đại diện = 1 ảnh nhìn thẳng đã cắt khuôn mặt lúc enroll (data/avatars/<id>/<key>); xóa cùng mẫu khuôn mặt.
  // v1.12.0: null = theo phòng; true = không chấm công; false = vẫn chấm công dù phòng không chấm công
  attendanceExempt   Boolean?
  faceAvatarKey      String?
  faceAvatarAt       DateTime?
  // v1.13.0: ảnh đại diện tự chọn (không dùng nhận diện), 600×800 JPEG ở data/photos/<id>/<key>; ưu tiên hơn ảnh khuôn mặt. Xóa khi nghỉ việc.
  photoKey           String?
  photoAt            DateTime?
  passwordHash       String
  mustChangePassword Boolean           @default(true)
  role               String            @default("EMPLOYEE") // ADMIN | HR | MANAGER | EMPLOYEE
  zaloUserId         String?           @unique
  zaloLinkedAt       DateTime?
  departmentId       Int
  department         Department        @relation("DeptMembers", fields: [departmentId], references: [id])
  managedDepartments Department[]      @relation("DeptManager")
  defaultShiftId     Int
  defaultShift       Shift             @relation(fields: [defaultShiftId], references: [id])
  scheduleType       String            @default("FIXED") // FIXED (theo mẫu tuần) | ROTATING (phải đăng ký ca tuần)
  workPatternId      Int?
  workPattern        WorkPattern?      @relation(fields: [workPatternId], references: [id])
  jobTitleId         Int?
  jobTitle           JobTitle?         @relation(fields: [jobTitleId], references: [id])
  specialtyId        Int?
  specialty          Specialty?        @relation(fields: [specialtyId], references: [id])
  avatarUrl          String?
  active             Boolean           @default(true)
  leftAt             DateTime? // thời điểm cho nghỉ việc: sau ngày này không còn lịch làm (không tính vắng)
  biometricConsentAt DateTime?
  failedLogins       Int               @default(0)
  lockedUntil        DateTime?
  sessionVersion     Int               @default(0) // tăng khi đổi/đặt lại mật khẩu, đăng xuất => mọi phiên (JWT) cũ hết hiệu lực
  createdAt          DateTime          @default(now())
  schedules          WorkSchedule[]
  logs               AttendanceLog[]
  faceTemplates      FaceTemplate[]
  requests           LeaveRequest[]    @relation("Requester")
  decidedRequests    LeaveRequest[]    @relation("Approver")
  managerDecidedRequests LeaveRequest[] @relation("ManagerApprover")
  license                PracticeLicense?
  credentials            Credential[]
  notifications      NotificationLog[]

  // v1.16.0: mọi danh sách đều lọc active + phòng rồi sắp theo mã; notify tra người duyệt theo vai trò.
  @@index([active, departmentId, code])
  @@index([role, active])
}

model Shift {
  id                Int             @id @default(autoincrement())
  name              String          @unique
  startTime         String          // "HH:mm" giờ VN
  endTime           String          // "HH:mm"; endTime <= startTime nghĩa là ca qua đêm
  breakMinutes      Int             @default(60)
  graceLateMinutes  Int             @default(5)
  graceEarlyMinutes Int             @default(0)
  breakStart        String?         // "HH:mm" giờ bắt đầu nghỉ; null => trừ đủ breakMinutes (cách cũ)
  workDayValue      Float           @default(1) // hệ số công chung của ca (vd. ca sáng T7 = 0.5)
  employees         Employee[]
  schedules         WorkSchedule[]
  logs              AttendanceLog[]
}

model WorkSchedule {
  id         Int      @id @default(autoincrement())
  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id])
  date       String   // "YYYY-MM-DD", ngày công theo giờ VN
  shiftId    Int?
  shift      Shift?   @relation(fields: [shiftId], references: [id])
  isDayOff   Boolean  @default(false)

  @@unique([employeeId, date])
  @@index([date])
}

model Holiday {
  date String @id // "YYYY-MM-DD"
  name String
}

model FaceTemplate {
  id           Int      @id @default(autoincrement())
  employeeId   Int
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  descriptor   Bytes    // Float32Array, mã hóa AES-256-GCM bằng BIOMETRIC_KEY
  modelVersion String
  createdById  Int
  createdAt    DateTime @default(now())

  @@index([employeeId])
}

model KioskDevice {
  id            Int             @id @default(autoincrement())
  name          String
  location      String?
  tokenHash     String?         @unique
  pairCode      String?
  pairExpiresAt DateTime?
  active        Boolean         @default(true)
  lastSeenAt    DateTime?
  logs          AttendanceLog[]
}

model AttendanceLog {
  id                 Int          @id @default(autoincrement())
  employeeId         Int
  employee           Employee     @relation(fields: [employeeId], references: [id])
  workDate           String       // ngày công mà lần quét thuộc về
  shiftId            Int?
  shift              Shift?       @relation(fields: [shiftId], references: [id])
  checkTime          DateTime     // UTC
  type               String       // IN | OUT
  isLate             Boolean      @default(false)
  lateMinutes        Int          @default(0)
  isEarly            Boolean      @default(false)
  earlyMinutes       Int          @default(0)
  excusedByRequestId Int?
  snapshotUrl        String?
  verified3D         Boolean      @default(false) // kết luận liveness do SERVER đặt
  livenessScore      Float?
  matchScore         Float?
  source             String       @default("KIOSK") // KIOSK | MANUAL
  deviceId           Int?
  device             KioskDevice? @relation(fields: [deviceId], references: [id])
  clientEventId      String?      @unique // chống ghi trùng khi đồng bộ offline
  sourceRequestId    Int? // log MANUAL sinh từ đơn bổ sung công đã duyệt
  note               String?
  createdById        Int?
  createdAt          DateTime     @default(now())

  @@index([employeeId, workDate])
  @@index([workDate])
}

model LeaveRequest {
  id           Int       @id @default(autoincrement())
  employeeId   Int
  employee     Employee  @relation("Requester", fields: [employeeId], references: [id])
  type         String    // NGHI_PHEP | VE_SOM | TANG_CA_OT | BO_SUNG_CONG
  fromTime     DateTime
  toTime       DateTime
  reason       String
  status       String    @default("PENDING") // PENDING | MANAGER_APPROVED (duyệt 2 bước: chờ HR) | APPROVED | REJECTED | CANCELLED
  approverId   Int?
  approver     Employee? @relation("Approver", fields: [approverId], references: [id])
  decidedAt    DateTime?
  decisionNote String?
  // Duyệt 2 bước (phòng TWO_STEP): bước 1 của trưởng phòng; approverId/decidedAt/decisionNote là quyết định cuối.
  managerApproverId Int?
  managerApprover   Employee? @relation("ManagerApprover", fields: [managerApproverId], references: [id])
  managerDecidedAt  DateTime?
  managerNote       String?
  // Đơn bổ sung công (quên chấm vào/ra): giờ cần bổ sung, và bước 2 "chấm tay" do Nhân sự thực hiện.
  correctionAt   DateTime?
  correctionKind String? // IN | OUT
  executedById   Int?
  executedAt     DateTime?
  executedLogId  Int?
  createdAt    DateTime  @default(now())

  @@index([employeeId, status])
  // v1.16.0: danh sách đơn chờ (Tổng quan, trang Đơn từ) lọc theo trạng thái / loại rồi sắp theo thời gian.
  @@index([status, createdAt])
  @@index([type, status, executedAt])
}

model NotificationLog {
  id           Int      @id @default(autoincrement())
  dedupeKey    String   @unique
  toEmployeeId Int?
  toEmployee   Employee? @relation(fields: [toEmployeeId], references: [id])
  toGroupId    String? // nhóm Zalo OA (GMF) — tin minh bạch cho quản trị
  messageType  String
  payload      String   // JSON
  status       String   // SENT | SIMULATED | FAILED | SKIPPED_NO_ZALO
  error        String?
  createdAt    DateTime @default(now())
}

model ZaloToken {
  id           Int      @id @default(1)
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  updatedAt    DateTime @updatedAt
}

model ZaloLinkCode {
  code       String   @id
  employeeId Int
  expiresAt  DateTime
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  actorId   Int?
  action    String
  entity    String
  entityId  String?
  detail    String?  // JSON
  createdAt DateTime @default(now())

  // v1.16.0: Tổng quan đếm/tra theo action + thời gian; bảng này lớn nhanh nhất nên không có chỉ mục là quét toàn bảng.
  @@index([action, createdAt])
}

model AppSetting {
  key   String @id
  value String
}

// Ma trận phân quyền chỉnh được trên web (ADMIN luôn có mọi quyền, không lưu ở đây).
model RolePermission {
  role       String
  capability String

  @@id([role, capability])
}

// Thư viện liên kết ("Thông tin" trong trang cá nhân): web app, Google Sheet, Drive, Docs…
// Ai được thấy: giao của visibleRoles và visibleDeptIds; mảng rỗng = tất cả.
model InfoLink {
  id             Int      @id @default(autoincrement())
  title          String
  url            String
  description    String?
  icon           String   @default("link")
  color          String   @default("brand")
  order          Int      @default(0)
  active         Boolean  @default(true)
  visibleRoles   String   @default("[]") // JSON string[] — rỗng = mọi vai trò
  visibleDeptIds String   @default("[]") // JSON number[] — rỗng = mọi phòng ban
  createdById    Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Mẫu tuần làm việc cho nhân viên ca cố định: ca theo từng thứ (null = nghỉ).
model WorkPattern {
  id         Int        @id @default(autoincrement())
  name       String     @unique
  monShiftId Int?
  tueShiftId Int?
  wedShiftId Int?
  thuShiftId Int?
  friShiftId Int?
  satShiftId Int?
  sunShiftId Int?
  employees  Employee[]
}

// Đăng ký ca tuần theo phòng ban: lịch (WorkSchedule) chỉ có hiệu lực khi tuần đã REGISTERED.
model RosterWeek {
  id             Int       @id @default(autoincrement())
  departmentId   Int
  weekStart      String // "YYYY-MM-DD" thứ Hai
  status         String    @default("DRAFT") // DRAFT | REGISTERED
  registeredById Int?
  registeredAt   DateTime?
  updatedAt      DateTime  @updatedAt

  @@unique([departmentId, weekStart])
  @@index([weekStart])
}

// Lịch sử phân công lịch làm việc (có hiệu lực từ ngày). Tính công ngày D dùng bản ghi mới nhất có effectiveFrom <= D,
// nên đổi mẫu tuần / loại lịch / phòng ban chỉ ảnh hưởng từ ngày đổi trở đi — công đã qua giữ nguyên.
// Cột ca theo thứ là bản chụp của mẫu tuần tại thời điểm đó (sửa mẫu tuần tạo bản ghi mới cho người đang dùng mẫu).
model ScheduleAssignment {
  id             Int      @id @default(autoincrement())
  employeeId     Int
  effectiveFrom  String // "YYYY-MM-DD"
  scheduleType   String
  departmentId   Int
  defaultShiftId Int
  workPatternId  Int?
  monShiftId     Int?
  tueShiftId     Int?
  wedShiftId     Int?
  thuShiftId     Int?
  friShiftId     Int?
  satShiftId     Int?
  sunShiftId     Int?
  createdAt      DateTime @default(now())

  @@unique([employeeId, effectiveFrom])
}

// Hệ số công riêng của phòng ban cho một ca (ghi đè Shift.workDayValue). Do Quản trị cấu hình.
model DepartmentShiftWeight {
  departmentId Int
  shiftId      Int
  workDayValue Float

  @@id([departmentId, shiftId])
}

// Chốt công tháng: tháng đã chốt => kết quả công từng ngày lấy từ bản chụp (LockedDay), mọi thao tác ghi làm đổi công bị chặn.
model PayrollLock {
  month      String   @id // "YYYY-MM"
  lockedById Int
  lockedAt   DateTime @default(now())
  totals     String? // JSON tổng hợp lúc chốt (số người, tổng công, giờ OT...)
}

// Bản chụp kết quả công của một nhân viên trong một ngày thuộc tháng đã chốt (JSON DaySummary + plan + logs).
model LockedDay {
  employeeId Int
  workDate     String
  month        String
  departmentId Int? // phòng ban của nhân viên vào ngày đó (báo cáo theo phòng của tháng đã chốt không đổi khi chuyển phòng)
  data         String

  @@id([employeeId, workDate])
  @@index([month])
}

// Nhóm chat GMF của OA đã dò được (webhook create_group) hoặc Quản trị nhập tay.
// Nhóm nhận loại tin nào do `categories` quyết định (v1.6.0, thay AppSetting zaloGroupId); mảng rỗng = không nhận tin.
model ZaloGroup {
  groupId       String   @id
  oaId          String?
  name          String?
  status        String? // enabled | disabled (theo API getgroup)
  totalMember   Int?
  source        String   @default("WEBHOOK") // WEBHOOK | MANUAL
  categories    String   @default("[]") // JSON: MINH_BACH | CHAM_CONG | DON_TU
  departmentIds String   @default("[]") // JSON id phòng; rỗng = mọi phòng (chỉ áp cho tin nhân viên)
  discoveredAt  DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// v1.9.0 — Giấy phép hành nghề (GPHN, thay CCHN cũ): 1 bản / nhân viên. Chỉ Nhân sự / Quản trị sửa; chính chủ xem.
model PracticeLicense {
  id            Int       @id @default(autoincrement())
  employeeId    Int       @unique
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  number        String // vd. 0015578/BYT-CCHN
  issuedAt      String // "YYYY-MM-DD"
  issuer        String // Bộ Y tế / Sở Y tế …
  subject       String // đối tượng cấp: Bác sĩ, Y sĩ, Điều dưỡng, Hộ sinh, Kỹ thuật y, Dược sĩ, Khác
  scope         String // phạm vi chuyên môn
  status        String    @default("ACTIVE") // ACTIVE | SUSPENDED | REVOKED | UNKNOWN
  expiresAt     String? // GPHN mới có thời hạn 5 năm; CCHN cũ không thời hạn → trống
  renewedAt     String? // ngày gia hạn gần nhất
  cmeCycleStart String // mốc chu kỳ CME 5 năm (mặc định = ngày gia hạn / ngày cấp)
  workplaceNote String? // nơi đăng ký hành nghề / ghi chú (vd. đang đứng tên nơi khác)
  verifiedAt    DateTime? // lần đối chiếu medinet gần nhất
  verifiedById  Int?
  // v1.11.0: lần tự tra cứu medinet gần nhất + kết quả (JSON: tìm thấy?, dữ liệu medinet, chỗ khác nhau, nơi công tác)
  medinetCheckedAt DateTime?
  medinetResult    String?
  updatedAt     DateTime  @updatedAt
}

// v1.9.0 — Văn bằng, chứng chỉ, CME … (nhiều / nhân viên), file scan tùy chọn lưu ở data/credentials/<employeeId>/.
model Credential {
  id          Int      @id @default(autoincrement())
  employeeId  Int
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type        String // DEGREE | SPECIALTY | CME | CDNN | RADIATION | LANG_IT | TEACHING | OTHER
  name        String
  issuer      String?
  number      String?
  issuedAt    String? // "YYYY-MM-DD" — CME tính theo ngày này
  expiresAt   String?
  cmeHours    Float? // số tiết CME (bắt buộc với loại CME)
  fileKey     String? // tên file trên đĩa (server đặt)
  fileName    String? // tên file gốc để hiển thị
  fileMime    String?
  fileSize    Int?
  createdById Int?
  createdAt   DateTime @default(now())

  @@index([employeeId, type])
}
